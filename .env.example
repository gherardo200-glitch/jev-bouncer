# Copy this file to .env and fill in real values. Never commit .env.
#
# Without TELEGRAM_BOT_TOKEN and JEV_API_KEY, `npm run demo` still works: it
# uses a local deterministic heuristic engine instead of calling any real API.

# Telegram bot token, from @BotFather on Telegram (/newbot).
# Required to run the real bot (`npm start`). Not needed for `npm run demo`.
TELEGRAM_BOT_TOKEN=

# Jev API key, from https://typesafe.ai (System One / Jev dashboard).
# Required to run real moderation decisions. Without it, the engine falls
# back to the local heuristic demo engine (see src/engine.ts).
JEV_API_KEY=

# Telegram chat ID where the bot sends moderation alerts (e.g. a private
# admin group). Get it by adding the bot to that chat and checking the
# chat_id in an update, or via a helper bot like @getidsbot.
ADMIN_CHAT_ID=

# Optional: path to a custom rules file. Defaults to config.yml if present,
# otherwise falls back to the bundled defaults (see config.example.yml).
# JEV_BOUNCER_CONFIG=./config.yml
